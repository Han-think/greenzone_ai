# 필수: 카카오 JavaScript 키 (Java 키나 REST API 키가 아님)
# 발급: https://developers.kakao.com/ → 내 애플리케이션 → 앱 키
# 카카오맵 사용 설정 및 허용 웹 도메인: http://localhost:8000
# 터미널의 --host localhost --port 8000으로 실행하고 같은 주소로 접속한다.
# 실제 .env에 값을 입력한다. 이 예제에는 실제 키를 넣지 않는다.
KAKAO_JAVASCRIPT_KEY=

# 카카오는 지도 표시와 지도 클릭 좌표의 주소 확인에 사용한다.
# 같은 JavaScript 키로 services 라이브러리를 불러오므로 추가 키는 필요 없다.
# 보유 주소·건물명 검색은 data 파일에서 처리하므로 검색용 키가 따로 필요 없다.
# VWorld / JUSO / Ollama / 배출 규칙 RAG는 현재 사용하지 않는다.

# 선택: Google AI Studio에서 발급한 Gemini API 키
# 발급: https://aistudio.google.com/api-keys
# 키가 없으면 사진 없이 공식 품목을 직접 검색할 수 있다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 선택: Opik에 사진 없는 후보·보류·오류·처리시간 기록
# 키 발급: https://www.comet.com/api/my/settings/
# WORKSPACE: https://www.comet.com/opik/워크스페이스명/projects 에서 확인
# AI 심사에 의한 환각 자동평가·사용자 최종선택 수집은 아직 하지 않는다.
OPIK_ENABLED=false
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=greenzone-vision-evaluation

# 관리자 로그인. 실제 .env에만 설정한다. 비밀번호는 16자 이상, 팀 공유 문서에 적지 않는다.
# http://localhost:8000/admin / 아이디 기본값 admin
# 로그인은 단일 서버 프로세스에서 8시간 유지되며 서버 재시작 시 해제된다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
